;
; assuming instantaneous detection, we set the delay to be 6 cycles
; plus the one cycle to set up so it should be like 50 ns
.pio_version 0 // only requires PIO version 0

.program squarewave
    set pindirs, 1   ; Set pin to output
    pull block ; pull value from OSR

    mov isr, osr; ISR now has pulse_count - 1

    pull block; now OSR has pulse_width

trigger:
    mov x, isr ; reset the pulse count for everytime the gpio changes
    wait 1 gpio 15   ; wait till gpio 15 goes high
    wait 0 gpio 15 [6] ; wait till gpio 15 is low then start
again:
    set pins, 1; drive pin high and then delay for one cycle
    mov y, osr; counter for pulse_width
high_delay:
    jmp y-- high_delay
    nop
    set pins, 0  ; Drive pin low, one less since pin stays high in jmp again
    mov y, osr
low_delay:
    jmp y-- low_delay
    jmp x-- again

    jmp trigger

.wrap


