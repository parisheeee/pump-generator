.program squarewave
.pio_version 0

; One frame arrives as three FIFO words from C:
;   1. pulse count - 1 -> X (2 means three pulses)
;   2. delay loop count -> ISR (saved for every trigger in this frame)
;   3. width loop count -> OSR (saved for every pulse in this frame)
; Y is our temporary countdown register. MOV leaves the saved values unchanged.

.wrap_target
load_frame:
    pull block
    mov x, osr
    pull block
    mov isr, osr
    pull block

next_trigger:
    ; PIN 0 means the input base configured in C: GPIO 15.
    ; Return here for EVERY pulse. No input edge means no new output pulse.
    wait 0 pin 0
    wait 1 pin 0

    ; After WAIT completes: MOV + (delay_count + 1) JMP cycles before SET HIGH.
    ; C sends delay_cycles - 2 to account for these instructions.
    mov y, isr
wait_delay:
    jmp y-- wait_delay
    set pins, 1

    ; HIGH lasts SET HIGH + MOV + (width_count + 1) JMP cycles.
    ; C sends width_cycles - 3 to account for these instructions.
    mov y, osr
wait_width:
    jmp y-- wait_width
    set pins, 0

    jmp x-- next_trigger
    irq 0                   ; All three pulses finished. Tell C the frame is done.
    ; Wrap to PULL BLOCK; output stays LOW until C supplies another frame.
.wrap


